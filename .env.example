# ── Server ──────────────────────────────────
PORT=3000

# ── Database ─────────────────────────────────
# Default: ./data/satta.db
DB_PATH=./data/satta.db

# ── Admin credentials ────────────────────────
# IMPORTANT: Change before going live!
# The admin password is re-synced from this value on EVERY server start (FIX 1.3)
ADMIN_PASSWORD=Admin@1234

# ── JWT secret ───────────────────────────────
# IMPORTANT: Use a long random string in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION
